# === Content backend (which repo/folder cici serves) ===
# Point cici at your PUBLIC content repo. Reads need no token when it's public.
CICI_REPO=owner/name
# Optional: only for the localhost CLI (`npx cici --repo … --token …`) to edit
# from your own machine. DO NOT set this on a hosted deploy — it is ignored in
# OAuth mode, and on older versions it would let ANY visitor write. Keep content
# public and edit via the OAuth sign-in below.
# CICI_TOKEN=

# === Auth (GitHub OAuth — required to edit on a hosted deploy) ===
# Create a GitHub OAuth App: https://github.com/settings/developers
#   Homepage URL:              https://your-domain
#   Authorization callback URL: https://your-domain/api/auth/callback/github
# Only the repo owner (derived from CICI_REPO's owner, or GITHUB_USERNAME) can edit.
NEXTAUTH_URL=https://your-domain
NEXTAUTH_SECRET=            # `openssl rand -base64 32`
GITHUB_ID=                  # OAuth App Client ID
GITHUB_SECRET=              # OAuth App Client Secret
# GITHUB_USERNAME=          # optional; owner is otherwise taken from CICI_REPO

# === Translation (auto-translate for blog content) ===
# DeepSeek Chat API key for translation
# Get one at https://platform.deepseek.com/api_keys
# Accepts either DEEPSEEK_APIKEY or DEEPSEEK_API_KEY.
# Uses the deepseek-chat model for high-quality translations.
# If unset, translation falls back to identity (no-op).
DEEPSEEK_APIKEY=

# Translation cache directory (default: data/translations)
# TRANSLATE_CACHE_DIR=data/translations

# === Analytics (Umami — privacy-focused, no cookies) ===
# Preferred: set `analytics.enabled` + `analytics.umamiWebsiteId` in cici.json
# (or pass --umami-site on the CLI). These env vars are the legacy fallback.
# NEXT_PUBLIC_ANALYTICS_ENABLED=true
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js   # only if self-hosting
